#--------------------------------------------------------------------
# .env.example — Feature 1: Consulta Pública con Captcha
#
# Copia este archivo como ".env" y ajusta los valores. NUNCA subas el
# ".env" real al repositorio: contiene credenciales y está en .gitignore.
#
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows / CMD)
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# RÉPLICA MYSQL (HU-22)
#--------------------------------------------------------------------
# El ApiRest solo se conecta a la réplica, con un usuario de solo lectura.
REPLICA_DB_HOST=mysql-replica
REPLICA_DB_PORT=3306
REPLICA_DB_NAME=oficina_agua
# Usuario del ApiRest: únicamente permiso SELECT.
REPLICA_DB_USER=consulta_ro
REPLICA_DB_PASSWORD=cambiar_esta_password
# Usuario administrador del contenedor de la réplica (solo para inicializarla).
REPLICA_DB_ROOT_PASSWORD=cambiar_esta_password_root

#--------------------------------------------------------------------
# APIREST DE CONSULTA (HU-23)
#--------------------------------------------------------------------
API_PORT=8081
# URL interna del ApiRest. Solo la conoce el servidor Web, nunca el navegador.
API_INTERNAL_URL=http://api:8081

#--------------------------------------------------------------------
# RATE LIMIT POR IP (HU-24)
#--------------------------------------------------------------------
# Máximo de consultas por IP dentro de la ventana de tiempo.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

#--------------------------------------------------------------------
# CAPTCHA (HU-25, HU-26) — reCAPTCHA v2 o hCaptcha
#--------------------------------------------------------------------
# Proveedor elegido: recaptcha | hcaptcha
CAPTCHA_PROVIDER=recaptcha
# Clave pública: puede viajar al navegador.
CAPTCHA_SITE_KEY=tu_site_key
# Clave secreta: solo en el servidor, nunca al navegador.
CAPTCHA_SECRET_KEY=tu_secret_key

#--------------------------------------------------------------------
# WEB (HU-25)
#--------------------------------------------------------------------
WEB_PORT=3000
